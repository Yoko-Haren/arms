# Secrets and local configuration
.env
.env.*
!.env.example

# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Local databases and generated application data
db.sqlite3
db.sqlite3.*
*.sqbpro
media/
staticfiles/
*.log

# Generated machine-learning artifacts (rebuild with `python manage.py train_ml_models`)
ml_engine/saved_models/*.pkl
ml_engine/saved_models/*.json

# Capstone paperwork (progress reports, seminar outputs): it names the team and adviser and is not part of the app
/reports/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime / data files
sqlite-data.json
*.sqlite
*.sqlite3

# Supabase local state (keep config/migrations tracked)
supabase/.temp/
supabase/.branches/

# One-off local scripts (seeding, wiping, debugging, admin bootstrap)
/create_admin.py
/seed_*.py
/wipe_*.py
/debug_grades.py
/fix_grades.py
/defense_demo.py

# Local cache files (core/caching.py)
.cache/

# Page snapshots made by `python manage.py export_screens` (rebuilt on demand; they hold account data)
design/screens/
