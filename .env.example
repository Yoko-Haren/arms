# Django production settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Supabase Postgres and Auth
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Google Sign-In — OAuth client (Web application) from Google Cloud Console.
# Authorised redirect URI: http://127.0.0.1:8000/accounts/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed callback URL for the deployed site
GOOGLE_REDIRECT_URI=
# Set to False to let users skip linking Google
GOOGLE_BINDING_REQUIRED=True

# Email for verification and password-reset codes (Gmail: use an App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Scaling out (optional). Leave empty on a single machine.
# Shared cache for several app servers: also run `pip install redis`.
REDIS_URL=
# Extra host names / origins when deployed, comma separated
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
